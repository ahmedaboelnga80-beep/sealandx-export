var SPREADSHEET_ID = "1U4T67Ao9HoE-p9pQjE_FVP_Kba5fa258vbxP4L1p41M";
var TARGET_SHEET_NAME = "All-Data";

/**
 * ⚠️ هام جداً: اضغط على زر "Run / تشغيل" لهذه الدالة مرة واحدة من داخل محرر Apps Script
 * للموافقة على صلاحيات Google Drive و Google Sheets قبل عمل Deploy.
 */
function authorizeDriveAndSheets() {
  var ss = SpreadsheetApp.openById(SPREADSHEET_ID);
  var folderName = "SealandX_Export_PDFs";
  var folders = DriveApp.getFoldersByName(folderName);
  var folder = folders.hasNext() ? folders.next() : DriveApp.createFolder(folderName);
  try {
    folder.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
  } catch (_) {}
  Logger.log("✅ تم تفعيل صلاحيات الشيت و Google Drive بنجاح! اسم الشيت: " + ss.getName() + " | مجلد الـ PDF: " + folder.getUrl());
}

/**
 * دالة مساعدة لكتابة القيم بأمان حتى لو كان العمود يحتوي على Data Validation صارم
 * ملاحظة هامة: يجب استدعاء SpreadsheetApp.flush() داخل try حتى يظهر خطأ الـ Validation فوراً ولا يوقف باقي أعمدة الصف
 */
function safeSetValue(range, value) {
  try {
    range.setValue(value);
    SpreadsheetApp.flush();
  } catch (validationErr) {
    try {
      range.clearDataValidations();
      range.setValue(value);
      SpreadsheetApp.flush();
    } catch (err2) {
      Logger.log("safeSetValue error: " + err2);
    }
  }
}

/**
 * توليد ملف PDF احتياطي تلقائياً إذا وصل التقرير بدون pdfBase64
 */
