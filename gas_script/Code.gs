  var html = '<!DOCTYPE html><html><head><meta charset="UTF-8"><style>'
    + 'body{font-family:Arial,sans-serif;padding:24px;color:#222;}'
    + '.hdr{border-bottom:3px solid #00897B;padding-bottom:10px;margin-bottom:16px;}'
    + '.sub{font-size:11px;color:#555;font-weight:bold;}'
    + '.ttl{font-size:22px;color:#1565C0;font-weight:bold;margin-top:4px;}'
    + 'table{width:100%;border-collapse:collapse;background:#f9f9f9;margin-bottom:18px;}'
    + 'td{border:1px solid #ccc;padding:8px 10px;font-size:12px;width:33%;}'
    + 'b{color:#004D40;}'
    + '.box-title{font-size:14px;font-weight:bold;color:#00897B;margin-bottom:6px;}'
    + '.box{border:1px solid #999;border-radius:4px;padding:12px;font-size:12px;min-height:50px;margin-bottom:16px;}'
    + '.ftr{margin-top:30px;font-size:10px;color:#777;border-top:1px solid #eee;padding-top:8px;}'
    + '</style></head><body>'
    + '<div class="hdr"><div class="sub">DATE: ' + dt + ' | SEALANDX INTEGRATED LOGISTICS</div>'
    + '<div class="ttl">SEAL Status Report</div></div>'
    + '<table>'
    + '<tr><td><b>BOOKING:</b> ' + bNo + '</td><td><b>SHIPPER:</b> ' + shp + '</td><td><b>SEAL NO:</b> ' + sNo + '</td></tr>'
    + '<tr><td><b>CONTAINER NO:</b> ' + cNo + '</td><td><b>SIZE:</b> ' + sz + '</td><td><b>TYPE:</b> ' + tp + '</td></tr>'
    + '<tr><td><b>LINE:</b> ' + ln + '</td><td><b>LOCATION:</b> ' + loc + '</td><td><b>SEALED:</b> ' + sld + '</td></tr>'
    + '</table>'
    + '<div class="box-title">REPORT CONTENT:</div>'
    + '<div class="box">' + rpt + '</div>'
    + '<div><b>SEALING PERSON:</b> ' + prs + '</div>'
    + '<div class="ftr">Generated by SealandX Export Cloud Sync</div>'
    + '</body></html>';

  return HtmlService.createHtmlOutput(html).getAs("application/pdf").setName(fileName);
}

function doGet(e) {
  if (e && e.parameter && e.parameter.action === 'mscTrack') {
    var trackNo = (e.parameter.trackingNumber || "").toString().trim().toUpperCase();
    var mode = (e.parameter.trackingMode || "1").toString();
    var mscRes = UrlFetchApp.fetch("https://www.msc.com/api/feature/tools/TrackingInfo", {
      method: "post",
      contentType: "application/json",
      headers: {
        "X-Requested-With": "XMLHttpRequest",
        "Accept": "application/json",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
      },
      payload: JSON.stringify({ trackingNumber: trackNo, trackingMode: mode }),
      muteHttpExceptions: true
    });
    return ContentService.createTextOutput(mscRes.getContentText())
      .setMimeType(ContentService.MimeType.JSON);
  }

  var driveStatus = "جاهز ومفعل ✓";
  try {
    DriveApp.getRootFolder();
  } catch (err) {
    driveStatus = "⚠️ يحتاج تشغيل دالة authorizeDriveAndSheets من محرر السكريبت";
  }

  var html = '<!DOCTYPE html><html><head><meta charset="UTF-8"><title>SealandX Export Sync Web App</title>'
    + '<style>body{font-family:Segoe UI,Tahoma,Arial,sans-serif;direction:rtl;text-align:center;padding:50px;background:#101d1d;color:#e0f2f1;}'
    + '.card{background:#1a2c2c;border-radius:14px;padding:35px;max-width:650px;margin:auto;box-shadow:0 8px 30px rgba(0,0,0,0.6);border:1px solid #00BFA5;}'
    + 'h1{color:#00BFA5;margin-bottom:10px;}p{line-height:1.7;font-size:16px;}.badge{background:#00BFA5;color:#00332c;padding:6px 14px;border-radius:20px;font-weight:bold;font-size:14px;}'
    + '.sheet-info{background:#122020;padding:12px;border-radius:8px;margin:20px 0;text-align:right;font-size:14px;color:#80cbc4;}'
    + '</style></head><body>'
    + '<div class="card">'
    + '<h1>⚓ SealandX Export Sync Web App</h1>'
    + '<p><span class="badge">الخدمة تعمل ومتصلة بالشيت بنجاح ✓</span></p>'
    + '<div class="sheet-info">'
    + '📌 <b>الصفحة المستهدفة:</b> All-Data (تغذية نظام الإقرارات)<br>'
    + '📄 <b>عمود رابط الـ PDF:</b> العمود M (Col 13)<br>'
    + '☁️ <b>حالة Google Drive:</b> ' + driveStatus + '<br>'
    + '🕒 <b>توقيت الخادم:</b> ' + new Date().toLocaleString()
    + '</div>'
    + '<p>الخدمة جاهزة لاستقبال تقارير الحاويات من تطبيق SealandX Export وحفظها تلقائياً.</p>'
    + '</div></body></html>';
  
  return HtmlService.createHtmlOutput(html)
    .setTitle("SealandX Export Sync Web App")
    .setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
}

function doPost(e) {
  var output = {};
  
  try {
    if (!e || !e.postData || !e.postData.contents) {
      throw new Error("لم يتم استلام أي بيانات في الطلب (Empty payload)");
    }

    var data = JSON.parse(e.postData.contents);
    var action = data.action || 'addReport';

    if (action === 'test') {
      var driveOk = false;
      var driveMsg = "";
      try {
        DriveApp.getRootFolder();
        driveOk = true;
      } catch (dErr) {
        driveMsg = " (تنبيه: صلاحية Google Drive غير مفعلة بعد في السكريبت: " + dErr + ")";
      }
      output = {
        status: "success",
        driveAuthorized: driveOk,
        message: "الاتصال بخدمة مزامنة SealandX Export يعمل بنجاح! ✓" + driveMsg
      };
      return ContentService.createTextOutput(JSON.stringify(output))
        .setMimeType(ContentService.MimeType.JSON);
    }

    if (action === 'mscTrack') {
      var trackNo = (data.trackingNumber || "").toString().trim().toUpperCase();
      var mode = (data.trackingMode || "1").toString();
      var mscRes = UrlFetchApp.fetch("https://www.msc.com/api/feature/tools/TrackingInfo", {
        method: "post",
        contentType: "application/json",
        headers: {
          "X-Requested-With": "XMLHttpRequest",
          "Accept": "application/json",
          "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"
        },
        payload: JSON.stringify({ trackingNumber: trackNo, trackingMode: mode }),
        muteHttpExceptions: true
      });
      return ContentService.createTextOutput(mscRes.getContentText())
        .setMimeType(ContentService.MimeType.JSON);
    }

    if (action === 'addReport') {
      var result = handleAddOrUpdateReport(data);
      output = {
        status: "success",
        message: "تم حفظ بيانات الحاوية والتقرير في All-Data بنجاح! ✓",
        containerNo: result.containerNo,
        bookingNo: result.bookingNo,
        rowNumber: result.rowNumber,
        isUpdate: result.isUpdate,
        pdfUrl: result.pdfUrl,
        pdfError: result.pdfError || ""
      };
    } else {
      throw new Error("إجراء غير معروف: " + action);
    }

  } catch (err) {
    output = {
      status: "error",
      message: err.toString()
    };
  }

  return ContentService.createTextOutput(JSON.stringify(output))
    .setMimeType(ContentService.MimeType.JSON);
}

/**
 * دالة إضافة أو تحديث الحاوية في صفحة All-Data ورفع الـ PDF
 */
function handleAddOrUpdateReport(data) {
  var ss;
  if (data.spreadsheetUrl && data.spreadsheetUrl.trim().length > 0) {
    try {
      ss = SpreadsheetApp.openByUrl(data.spreadsheetUrl.trim());
    } catch (_) {
      ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    }
  } else {
    try {
      ss = SpreadsheetApp.getActiveSpreadsheet();
    } catch (_) {}
    if (!ss) {
      ss = SpreadsheetApp.openById(SPREADSHEET_ID);
    }
  }

  if (!ss) {
    throw new Error("تعذر فتح ملف Google Spreadsheet.");
  }

  var sheetName = data.targetSheetName || TARGET_SHEET_NAME;
  var sheet = ss.getSheetByName(sheetName);
  if (!sheet) {
    sheet = ss.getSheetByName(TARGET_SHEET_NAME);
  }
  if (!sheet) {
    throw new Error("صفحة " + sheetName + " غير موجودة في الشيت.");
  }

  // 1. التأكد من وجود ترويسة عمود الـ PDF في الخلية M5 (العمود 13)
  try {
    var headerM = sheet.getRange(5, 13).getValue();
    if (!headerM || headerM.toString().trim() === "") {
      var cellM5 = sheet.getRange(5, 13);
      cellM5.setValue("تقرير PDF (Google Drive)")
            .setBackground("#00897B")
            .setFontColor("#FFFFFF")
            .setFontWeight("bold")
            .setHorizontalAlignment("center")
            .setVerticalAlignment("middle");
      sheet.setColumnWidth(13, 160);
    }
  } catch (_) {}

  // 2. معالجة وحفظ ملف الـ PDF في Google Drive (أو توليد PDF تلقائي إذا لم يصل pdfBase64)
  var pdfUrl = "";
  var pdfError = "";
  try {
    var folderName = "SealandX_Export_PDFs";
    var folders = DriveApp.getFoldersByName(folderName);
    var folder;
    if (folders.hasNext()) {
      folder = folders.next();
    } else {
      folder = DriveApp.createFolder(folderName);
      try {
        folder.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
      } catch (_) {}
    }

    var cNo = (data.containerNo || "CONTAINER").toString().trim().toUpperCase();
    var sNo = (data.sealNo || "").toString().trim().toUpperCase();
    var bNo = (data.bookingNo || "").toString().trim().toUpperCase();
    var dateStr = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyyMMdd_HHmmss");
    var fileName = cNo + (bNo ? "_" + bNo : "") + (sNo ? "_" + sNo : "") + "_" + dateStr + ".pdf";

    var blob;
    if (data.pdfBase64 && data.pdfBase64.toString().trim().length > 0) {
      var cleanB64 = data.pdfBase64.toString().trim();
      if (cleanB64.indexOf(",") > -1) {
        cleanB64 = cleanB64.split(",")[1];
      }
      cleanB64 = cleanB64.replace(/\s+/g, "");
      var decodedBytes = Utilities.base64Decode(cleanB64);
      blob = Utilities.newBlob(decodedBytes, "application/pdf", fileName);
    } else {
      blob = createFallbackPdfBlob(data, fileName);
    }

    var file = folder.createFile(blob);
    try {
      file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    } catch (shareErr) {
      Logger.log("Permission notice: " + shareErr);
    }
    pdfUrl = file.getUrl();
  } catch (pdfErr) {
    pdfError = pdfErr.toString();
    Logger.log("Error saving PDF to Google Drive: " + pdfErr);
  }

  // 3. تطبيع البيانات لتطابق نمط All-Data بدقة
  var rawContainerNo = (data.containerNo || "").toString().trim().toUpperCase();
  var bookingNo = (data.bookingNo || "").toString().trim().toUpperCase();
  var shippers = (data.shippers || "").toString().trim().toUpperCase();
  var sealNo = (data.sealNo || "").toString().trim().toUpperCase();
  
  // تطبيع النوع Type (DV -> D.V / HC -> H.C)
  var rawType = (data.type || "").toString().trim().toUpperCase();
  if (rawType === "DV") rawType = "D.V";
  if (rawType === "HC") rawType = "H.C";
  if (rawType === "OT") rawType = "O.T";
  if (rawType === "RF") rawType = "R.F";
  if (rawType === "FR") rawType = "F.R";

  // تطبيع المقاس Size (20 -> 20.0 أو 20)
  var rawSize = (data.size || "").toString().trim();
  if (rawSize === "20") rawSize = 20;
  else if (rawSize === "40") rawSize = 40;
  else if (rawSize === "45") rawSize = 45;

  var sealingPerson = (data.sealingPerson || data.inspector || "").toString().trim().toUpperCase();
  var notes = (data.report || "").toString().trim();

  // تنسيق التاريخ ليطابق تاريخ التسيل (yyyy-MM-dd)
  var sealingDate = data.createdAt;
  try {
    if (!sealingDate || sealingDate.toString().trim() === "") {
      sealingDate = new Date();
    } else {
      var parsed = new Date(sealingDate);
      if (!isNaN(parsed.getTime())) {
        sealingDate = parsed;
      }
    }
  } catch (_) {
    sealingDate = new Date();
  }

  // 4. البحث عن الحاوية في العمود E (العمود 5) بدءاً من الصف 6
  var maxScanRows = Math.min(sheet.getLastRow(), 15000);
  if (maxScanRows < 6) maxScanRows = 6;
  var numRowsToScan = maxScanRows - 5;
  
  // قراءة الأعمدة C و D و E دفعة واحدة للسرعة العالية
  var cdeValues = sheet.getRange(6, 3, numRowsToScan, 3).getValues();
  
  var existingRow = -1;
  var firstEmptyRow = -1;

  for (var i = 0; i < cdeValues.length; i++) {
    var bookingVal = (cdeValues[i][0] || "").toString().trim();
    var containerVal = (cdeValues[i][2] || "").toString().trim().toUpperCase();
    if (rawContainerNo.length > 0 && containerVal === rawContainerNo) {
      existingRow = i + 6;
      break;
    }
    if (firstEmptyRow === -1 && containerVal === "" && bookingVal === "") {
      firstEmptyRow = i + 6;
    }
  }

  var targetRow;
  var isUpdate = false;

  if (existingRow !== -1) {
    targetRow = existingRow;
    isUpdate = true;
  } else if (firstEmptyRow !== -1) {
    targetRow = firstEmptyRow;
  } else {
    targetRow = maxScanRows + 1;
  }

  // إزالة قيود التحقق الصارمة (Data Validation) من خلايا النوع والمقاس وعمود التقرير في هذا الصف قبل الكتابة
  // لأن الشيت يوقف كتابة باقي الصف بالكامل عند عمل flush إذا كانت القيمة (مثل H.C) غير موجودة في قائمة التحقق
  try {
    sheet.getRange(targetRow, 6, 1, 2).clearDataValidations();
    sheet.getRange(targetRow, 13).clearDataValidations();
    SpreadsheetApp.flush();
  } catch (_) {}

  // 5. كتابة أو تحديث البيانات في الصف المحدد
  // Col A: معادلة المسلسل
  try {
    sheet.getRange(targetRow, 1).setFormula("=ROW()-5");
  } catch (_) {}

  // Col B: معادلة مفتاح البوكينج والإقرار (محفوظة كما هي بالضبط)
  try {
    sheet.getRange(targetRow, 2).setFormula("=C" + targetRow + "&COUNTIF($C$6:C" + targetRow + ",C" + targetRow + ")");
  } catch (_) {}

  // Col C: Booking No
  if (bookingNo.length > 0) {
    safeSetValue(sheet.getRange(targetRow, 3), bookingNo);
  }

  // Col D: Shippers
  if (shippers.length > 0) {
    safeSetValue(sheet.getRange(targetRow, 4), shippers);
  }

  // Col E: Container No
  safeSetValue(sheet.getRange(targetRow, 5), rawContainerNo);

  // Col F: Type
  if (rawType.length > 0) {
    safeSetValue(sheet.getRange(targetRow, 6), rawType);
  }

  // Col G: Size
  if (rawSize !== "") {
    safeSetValue(sheet.getRange(targetRow, 7), rawSize);
  }

  // Col H: Seal No
  if (sealNo.length > 0) {
    safeSetValue(sheet.getRange(targetRow, 8), sealNo);
  }

  // Col I: Sealing Personal
  if (sealingPerson.length > 0) {
    safeSetValue(sheet.getRange(targetRow, 9), sealingPerson);
  }

  // Col J: Sealing Date
  safeSetValue(sheet.getRange(targetRow, 10), sealingDate);

  // Col K: Revision Details (يحتوي على Data Validation في الشيت الأصلي: Reviewed / Reported / Error)
  if (notes.length > 0) {
    if (notes === "Reviewed" || notes === "Reported" || notes === "Error") {
      safeSetValue(sheet.getRange(targetRow, 11), notes);
    } else {
      try {
        sheet.getRange(targetRow, 12).setNote(notes);
      } catch (_) {}
    }
  }

  // Col L: Reporting Details
  safeSetValue(sheet.getRange(targetRow, 12), "Reported");

  // Col M: رابط التقرير PDF (العمود 13)
  if (pdfUrl && pdfUrl.length > 0) {
    var cellM = sheet.getRange(targetRow, 13);
    var formulaComma = '=HYPERLINK("' + pdfUrl + '", "View report")';
    var formulaSemicolon = '=HYPERLINK("' + pdfUrl + '"; "View report")';
    var linkWritten = false;
    try {
      cellM.setFormula(formulaComma);
      SpreadsheetApp.flush();
      linkWritten = true;
    } catch (_) {
      try {
        cellM.setFormula(formulaSemicolon);
        SpreadsheetApp.flush();
        linkWritten = true;
      } catch (__) {}
    }
    if (!linkWritten) {
      try {
        var richText = SpreadsheetApp.newRichTextValue()
          .setText("View report")
          .setLinkUrl(pdfUrl)
          .build();
        cellM.setRichTextValue(richText);
        SpreadsheetApp.flush();
        linkWritten = true;
      } catch (___) {
        safeSetValue(cellM, pdfUrl);
      }
    }
  }

  // تنسيق الصف
  try {
    var rowRange = sheet.getRange(targetRow, 1, 1, 13);
    rowRange.setHorizontalAlignment("center")
            .setVerticalAlignment("middle")
            .setFontFamily("Arial")
            .setFontSize(10);
    SpreadsheetApp.flush();
  } catch (_) {}

  return {
    rowNumber: targetRow,
    isUpdate: isUpdate,
    containerNo: rawContainerNo,
    bookingNo: bookingNo,
    pdfUrl: pdfUrl,
    pdfError: pdfError
  };
}
